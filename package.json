{
  "name": "block-editor-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "eslint \"packages/**/src/**/*.{js,jsx,ts,tsx,vue}\" \"apps/**/src/**/*.{js,jsx,ts,tsx,vue}\"",
    "lint:fix": "eslint \"packages/**/src/**/*.{js,jsx,ts,tsx,vue}\" \"apps/**/src/**/*.{js,jsx,ts,tsx,vue}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "pnpm --filter @block-editor/editor test",
    "test:e2e": "pnpm --filter block-editor-playground test:e2e",
    "release:gate": "pnpm test:unit && pnpm test:e2e && pnpm --dir docs docs:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "vue": "^3.5.29"
  }
}
